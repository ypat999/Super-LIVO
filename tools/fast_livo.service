[Unit]
Description=FAST-LIVO realtime mapping (Super-LIVO solution A: Livox MID360 + Hik camera)
Documentation=file:///home/ztl/git/sl_ws/Super-LIVO/docs/RK3588_DEPLOY_AND_BENCH.md
# 刻意不依赖 network-online.target：实测本机 systemd-networkd-wait-online 在开机时
# 要等约 100 s 才判定 online，把建图服务一起拖到 1 分半后才启动。雷达走链路本地
# 以太网、相机走 USB，都不需要"网络在线"；话题未就绪由脚本自身重试覆盖。
After=local-fs.target

[Service]
Type=simple
User=ztl
Group=ztl
Environment=HOME=/home/ztl
Environment=ROS_DOMAIN_ID=93
WorkingDirectory=/home/ztl
# 脚本内部按需拉起雷达/相机，并以前台方式运行 visual_a_app（日志同时写 <out>/app.log）
ExecStart=/bin/bash /home/ztl/visual_a_live.sh
# SIGINT 才会走 shutdownAndSave()（写最终合并彩色图），SIGTERM 由 rclcpp 一并处理
KillSignal=SIGINT
# 退出时合并几百万点 + 中位数回填需要数秒
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
SupplementaryGroups=video render

[Install]
WantedBy=multi-user.target
